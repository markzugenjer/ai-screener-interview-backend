# Voice agent settings. Copy to agent/.env.

API_INTERNAL_URL=http://localhost:8080
INTERNAL_API_SECRET=             # same value as the API's INTERNAL_API_SECRET

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ai-screener

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
STT_LANGUAGE=id

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=             # optional: pick an Indonesian-sounding voice in the ElevenLabs voice library

ANTHROPIC_API_KEY=
AGENT_LLM_MODEL=claude-haiku-5-5 # fast model for live conversation
