# Copy to .env and fill in. Never commit .env.

# production enables strict checks
APP_ENV=development
HTTP_ADDR=:8080
# the Next.js site; also the only allowed origin
PUBLIC_URL=http://localhost:3000
# postgres, or memory for a quick demo without a database
STORE=postgres
DATABASE_URL=postgres://screener:screener@localhost:5432/screener?sslmode=disable

# Security — generate both with: openssl rand -base64 32
# AES-256 key for WhatsApp numbers and resume files. Back it up: losing it makes that data unreadable.
APP_ENCRYPTION_KEY=
# shared secret between this API and the voice agent (32+ characters)
INTERNAL_API_SECRET=
# set true when served over HTTPS (required in production)
COOKIE_SECURE=false
SESSION_TTL=168h
# the API sits behind the Next.js proxy
TRUST_PROXY=true
MAX_RESUME_MB=5
# encrypted uploads
STORAGE_DIR=./data/files

# First admin account, created on startup if the email doesn't exist yet. Remove afterwards.
ADMIN_EMAIL=
# at least 12 characters
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# LiveKit Cloud (Settings > API Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ai-screener

# Claude, for scoring (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
# or "Bahasa Indonesia"
FEEDBACK_LANGUAGE=English

# true runs scoring inside the API process (simple single-server setups)
RUN_WORKER_IN_API=false
# adds two demo programmer jobs when the jobs table is empty
SEED_DEMO=true
