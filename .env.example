# Copy to .env and fill in. Never commit .env.

APP_ENV=development              # production enables strict checks
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:3000 # the Next.js site; also the only allowed origin
STORE=postgres                   # postgres, or memory for a quick demo without a database
DATABASE_URL=postgres://screener:screener@localhost:5432/screener?sslmode=disable

# Security — generate both with: openssl rand -base64 32
APP_ENCRYPTION_KEY=              # AES-256 key for WhatsApp numbers and resume files. Back it up: losing it makes that data unreadable.
INTERNAL_API_SECRET=             # shared secret between this API and the voice agent (32+ characters)
COOKIE_SECURE=false              # set true when served over HTTPS (required in production)
SESSION_TTL=168h
TRUST_PROXY=true                 # the API sits behind the Next.js proxy
MAX_RESUME_MB=5
STORAGE_DIR=./data/files         # encrypted uploads

# First admin account, created on startup if the email doesn't exist yet. Remove afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=                  # at least 12 characters
ADMIN_NAME=Admin

# LiveKit Cloud (Settings > API Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ai-screener

# Claude, for scoring (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
FEEDBACK_LANGUAGE=English        # or "Bahasa Indonesia"

RUN_WORKER_IN_API=false          # true runs scoring inside the API process (simple single-server setups)
SEED_DEMO=true                   # adds two demo programmer jobs when the jobs table is empty
